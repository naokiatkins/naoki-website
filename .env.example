# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Neon / Vercel Postgres connection string
POSTGRES_URL=

# Vercel Blob read-write token (set automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=

# Your Calendly event link, e.g. https://calendly.com/your-name/30min
# Only read by the API route, so it is sent to the browser only after a passing
# score. Never reference it from client components: Next would inline it into
# the browser bundle because of the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CALENDLY_URL=

# Score (0-100) needed to unlock the booking link
MATCH_THRESHOLD=70
